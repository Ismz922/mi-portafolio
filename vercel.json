{
  "version": 2,
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/mi-portafolio/browser",
  "devCommand": "ng serve",
  "installCommand": "npm install",
  "framework": "angular",
  "routes": [
    {
      "src": "/en/(.*)",
      "dest": "/en/index.html"
    },
    {
      "src": "/es/(.*)",
      "dest": "/es/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}